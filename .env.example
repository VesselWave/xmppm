# xmp.pm invite workflow deployment example
# Copy to local deploy env files as needed. Do not commit real secrets.

# Telegram bot used for admin approvals and VPS monitoring alerts.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=replace-with-admin-chat-id
TELEGRAM_ADMIN_USER_IDS=replace-with-comma-separated-admin-user-ids

# Cloudflare Worker secrets.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
AGENT_BEARER_TOKEN=replace-with-random-agent-token
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key

# Public Cloudflare Turnstile site key; goes in wrangler.toml [vars].
TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key

# Worker public/config vars.
SERVICE_DOMAIN=xmp.pm
STATUS_BASE_URL=https://xmp.pm
REQUEST_RETENTION_DAYS=7
APPROVED_RETENTION_DAYS=14
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_SUBMISSIONS=3
# Comma-separated client IPs that bypass only request rate-limiting; Turnstile and review still apply.
RATE_LIMIT_BYPASS_IPS=
# Comma-separated direct Cloudflare cf-connecting-ip values that bypass rate-limiting, Turnstile, and Telegram review; empty disables auto-approval.
TRUSTED_FORM_IPS=

# VPS agent env: install as /etc/xmppm-agent.env.
XMPPM_WORKER_BASE_URL=https://xmp.pm
XMPPM_AGENT_TOKEN=replace-with-same-value-as-AGENT_BEARER_TOKEN
XMPPM_POLL_SECONDS=30

# Optional live end-to-end invite smoke check on VPS agent.
# Requires VPS IP in TRUSTED_FORM_IPS so /request auto-approves.
XMPPM_SMOKE_ENABLED=false
XMPPM_SMOKE_INTERVAL_SECONDS=3600
XMPPM_SMOKE_USERNAME_PREFIX=smoke
