# xmp.pm DNS template
# Current public DNS records.

# Cloudflare Worker-routed site hostnames. Keep proxied in Cloudflare.
# These are originless placeholders for Worker routes, not VPS addresses.
A      @                  192.0.2.0
AAAA   @                  100::
A      www                192.0.2.0
AAAA   www                100::

# Native XMPP and HTTPS gateway endpoints on the VPS. Keep DNS-only.
A      xmpp               152.67.66.204
AAAA   xmpp               2603:c022:7:58aa:0:b12d:ff7e:10a6
A      upload             152.67.66.204
AAAA   upload             2603:c022:7:58aa:0:b12d:ff7e:10a6
A      conference         152.67.66.204
AAAA   conference         2603:c022:7:58aa:0:b12d:ff7e:10a6
A      pubsub             152.67.66.204
AAAA   pubsub             2603:c022:7:58aa:0:b12d:ff7e:10a6

# XMPP client/server discovery.
SRV    _xmpp-client._tcp  0 5 5222 xmpp.xmp.pm.
SRV    _xmpp-server._tcp  0 5 5269 xmpp.xmp.pm.
SRV    _xmpps-client._tcp 0 5 5223 xmpp.xmp.pm.
SRV    _xmpps-server._tcp 0 5 5270 xmpp.xmp.pm.

# STUN/TURN discovery.
SRV    _stun._tcp         0 5 3478 xmpp.xmp.pm.
SRV    _stun._udp         0 5 3478 xmpp.xmp.pm.
SRV    _stuns._tcp        0 5 5349 xmpp.xmp.pm.
SRV    _turn._tcp         0 5 3478 xmpp.xmp.pm.
SRV    _turn._udp         0 5 3478 xmpp.xmp.pm.
SRV    _turns._tcp        0 5 5349 xmpp.xmp.pm.

# XEP-0156 web discovery hints.
TXT    _xmppconnect       "_xmpp-client-websocket=wss://xmpp.xmp.pm/ws"
TXT    _xmppconnect       "_xmpp-client-xbosh=https://xmpp.xmp.pm/bosh"

# ACME DNS challenge placeholder if using DNS-01 validation.
# CNAME _acme-challenge  REPLACE_WITH_ACME_DNS_TARGET.

# DNSSEC parent-zone DS record. Do not add this in Cloudflare DNS records.
