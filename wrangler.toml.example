name = "xmppm-invites"
main = "apps/worker/index.ts"
workers_dev = false
compatibility_date = "2026-06-15"
routes = [ { pattern = "xmp.pm/*", zone_name = "xmp.pm" }, { pattern = "www.xmp.pm/*", zone_name = "xmp.pm" }, ]

[assets]
directory = "./apps/website"
binding = "ASSETS"
run_worker_first = true
html_handling = "none"

[triggers]
crons = ["17 3 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "xmppm_invites"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"

[vars]
SERVICE_DOMAIN = "xmp.pm"
STATUS_BASE_URL = "https://xmp.pm"
REQUEST_RETENTION_DAYS = "7"
APPROVED_RETENTION_DAYS = "14"
RATE_LIMIT_WINDOW_SECONDS = "3600"
RATE_LIMIT_MAX_SUBMISSIONS = "3"
# Comma-separated client IPs that bypass only request rate-limiting; Turnstile and review still apply.
# For production, set these as environment-specific secrets/vars instead of committing real IPs.
RATE_LIMIT_BYPASS_IPS = ""
TURNSTILE_SITE_KEY = "REPLACE_WITH_TURNSTILE_SITE_KEY"
# Comma-separated direct Cloudflare cf-connecting-ip values that bypass rate-limiting, Turnstile, and Telegram review; leave empty to disable.
# For production, set these as environment-specific secrets/vars instead of committing real IPs.
TRUSTED_FORM_IPS = ""

# Set as Worker secrets:
# TELEGRAM_ADMIN_CHAT_ID
# TELEGRAM_ADMIN_USER_IDS
# TELEGRAM_BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET
# AGENT_BEARER_TOKEN
# TURNSTILE_SECRET_KEY
